{
  "hosting": {
    "public": "firebase/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/_empty"],
    "cleanUrls": false,
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "fastorial-jobs-backend", "region": "asia-south1" } },
      { "source": "**", "run": { "serviceId": "fastorial-jobs-frontend", "region": "asia-south1" } }
    ]
  }
}
