# Public origin, inlined at build time (metadataBase, share links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (same variables as the former Spring Boot backend). JDBC or postgres:// URLs both work;
# add ?sslmode=require for hosted databases that need TLS. Migrations run when the server starts.
DB_URL=jdbc:postgresql://localhost:5432/fastorial_jobs
DB_USER=fastorial
DB_PASSWORD=fastorial
# Connections per server instance (default 5)
# DB_POOL_SIZE=5

# Token typed on /admin/login, also accepted as X-Admin-Token on /api/admin/**
ADMIN_TOKEN=change-me
# X-Internal-Secret for POST /api/internal/jobs/cleanup
CLEANUP_SECRET=change-me

# Optional analytics (leave empty to disable). Umami:
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# or Plausible:
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
