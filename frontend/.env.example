# Public origin, inlined at build time (metadataBase, share links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public backend origin. Used by the browser too, so the backend must allow the site origin via
# CORS_ALLOWED_ORIGINS. Inlined at build time
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional: internal backend address for server side calls only (defaults to NEXT_PUBLIC_API_URL)
# API_BASE_URL=http://backend:8080
# Token typed on /admin/login. Must equal the backend ADMIN_TOKEN
ADMIN_TOKEN=change-me

# Optional analytics (leave empty to disable). Umami:
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# or Plausible:
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
